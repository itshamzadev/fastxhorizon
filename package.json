{
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "npm run build:bundles && npm run ensure:symlink",
        "build:prod": "rm -f public/hot 'public/hot 2' && npm run build:bundles && npm run ensure:symlink",
        "build:bundles": "vite build && php artisan prepare:builder-bundle build.zip",
        "ensure:symlink": "test -L build || ln -s public/build build",
        "test:e2e": "npx playwright test",
        "test:e2e:ui": "npx playwright test --ui",
        "test:e2e:headed": "npx playwright test --headed",
        "test:e2e:report": "npx playwright show-report"
    },
    "devDependencies": {
        "@playwright/test": "^1.59.1",
        "@types/node": "^25.6.0",
        "@vitejs/plugin-react": "^4.7.0",
        "laravel-vite-plugin": "^1.3.0",
        "vite": "^6.4.3"
    },
    "dependencies": {
        "@inertiajs/react": "^3.5.0",
        "@msishariful/claude-usage-cli": "^1.1.0",
        "@react-google-maps/api": "^2.20.8",
        "axios": "^1.18.1",
        "firebase": "^12.15.0",
        "i18next": "^26.3.4",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^17.0.8",
        "react-phone-input-2": "^2.15.1",
        "swiper": "^14.0.1",
        "ziggy-js": "^2.6.3"
    }
}
