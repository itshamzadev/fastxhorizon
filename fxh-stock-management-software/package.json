{
  "name": "fxh-stock-management-software",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first physical inventory and sales management for FASTXHORIZON.",
  "main": "dist-electron/main.js",
  "author": "FASTXHORIZON (PRIVATE) LIMITED",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "clean:electron": "node scripts/clean-electron-build.mjs",
    "build": "npm run build:renderer && npm run clean:electron && tsc -p tsconfig.electron.json && electron-builder --dir",
    "build:renderer": "node scripts/build-renderer.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "dist": "npm run build:renderer && tsc -p tsconfig.electron.json && electron-builder",
    "db:smoke": "tsx scripts/smoke-db.ts",
    "test:export": "tsx scripts/export-smoke.ts",
    "test:zip": "tsx scripts/zip-regression.ts",
    "test:website-export": "tsx scripts/website-export-package.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "better-sqlite3": "^11.8.1",
    "lucide-react": "^0.511.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@rollup/wasm-node": "^4.67.5",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.8",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.fastxhorizon.stockmanager",
    "productName": "FASTXHORIZON Stock Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@35.7.5": true
  }
}
