APP_NAME=FastXHorizon
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_MODE=live
APP_URL=https://api.fastxhorizon.com
APP_REGION=
APP_INSTANCE_ID=
FRONTEND_MODE=blade
LOG_CHANNEL=single
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
REDIS_DB=0
REDIS_CACHE_DB=1
FASTXHORIZON_READINESS_REDIS_REQUIRED=false
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_QUEUE=default
REDIS_PREFIX=fastxhorizon_
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
FILESYSTEM_DISK=public
# Legacy installer compatibility; use FILESYSTEM_DISK for new deployments.
FILESYSTEM_DRIVER=local
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
NEXMO_KEY=
NEXMO_SECRET=
PURCHASE_CODE=
BUYER_USERNAME=
SOFTWARE_ID=MzE0NDg1OTc=

OPENAI_API_KEY=
OPENAI_ORGANIZATION=

NGINX_PORT=8302
FORCE_HTTPS=true
CONTAINER_NAME_PREFIX=6valley-demo

# Safepay remains disabled until a verified sandbox contract and credentials are configured.
SAFEPAY_ENABLED=false
SAFEPAY_ENV=sandbox
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_BASE_URL=
SAFEPAY_SUCCESS_URL=
SAFEPAY_CANCEL_URL=

# The single hostname where the admin/vendor panel + all host routes live.
# Sub-domains and custom domains in tenant_domain_configs serve the
# storefront at root. Leave both unset for single-tenant / legacy installs.
APP_HOST_DOMAIN=
APP_HOST_BASE_DOMAIN=
APP_PUBLIC_IP=
CORS_ALLOWED_ORIGINS=https://www.fastxhorizon.com

# Optional Firebase service-account file path or JSON document. Leave blank
# until real credentials are configured.
FIREBASE_CREDENTIALS=
