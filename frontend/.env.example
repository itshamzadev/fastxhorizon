# Local development API (recommended when the CRA proxy is unavailable).
REACT_APP_API_BASE_URL=http://127.0.0.1:5000/api

# Alternatively, set this to true to use setupProxy.js with a local backend.
# REACT_APP_API_USE_PROXY=true
# For a separately hosted API, replace the URL above.

# TikTok Pixel (public storefront). Leave empty to disable tracking.
REACT_APP_TIKTOK_PIXEL_ID=DBJMGBBC77U4J2JQQ1TG
