# Copy these keys into the Coolify backend resource. Set real values in the
# Coolify secret manager; this file intentionally contains no credentials.
NODE_ENV=production
PORT=5000
ADMIN_BIND_HOST=0.0.0.0
MONGO_URI=mongodb://<private-mongo-host>:27017/fastxhorizon
JWT_SECRET=<generate-a-long-random-secret>
ADMIN_TOTP_ENCRYPTION_KEY=<generate-a-32-byte-key>
ADMIN_TOTP_ISSUER=FASTXHORIZON Admin
ADMIN_DEV_SKIP_MFA=false
PRODUCTION_MONGO_PRIVATE_NETWORK=true
MONGO_PRIVATE_HOST_ALLOWLIST=
ADMIN_COOKIE_DOMAIN=.fastxhorizon.com
CORS_ORIGINS=https://fastxhorizon.com,https://www.fastxhorizon.com,https://controlpanel.fastxhorizon.com
SKIP_SEED_ON_START=true
FORCE_SEED_ON_START=false
PAYMENT_PROOF_STORAGE_PATH=/app/storage/payment-proof
# Persistent host/object-storage mount must provide /app/media/products.
MEDIA_STORAGE_ROOT=/app/media
# Optional integrations; leave unset until configured and tested.
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=
GOOGLE_AI_API_KEY=
